# ==========================================================================
# SECRETS — never commit. (.env.example is committed, .env is not.)
# ==========================================================================
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials.json
service-account*.json

# ==========================================================================
# INTERNAL PLANNING DOCS / AGENT INSTRUCTIONS — must not reach the public repo
# (Blueprint Section 29: this is the exact mistake that disqualified ELECTRA)
# ==========================================================================
CLAUDE.md
AGENTS.md
GEMINI.md
.cursorrules
docs/internal/
docs/planning/
*_Blueprint.md
*_Implementation_Blueprint.md
*_SIH_Proposal.md
*-Buildchain-Brief.md
*_PRD_draft*.md

