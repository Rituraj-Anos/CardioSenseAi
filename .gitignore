# ==========================================================================
# Data & ML artifacts — raw signals and trained weights stay out of git
# ==========================================================================
data/pcg_demo/*
!data/pcg_demo/.gitkeep
data/ecg_demo/*
!data/ecg_demo/.gitkeep
data/raw/
data/uploads/
storage/
*.wav
*.dat
*.hea
*.atr
*.pkl
*.joblib
*.pt
*.pth
*.onnx
*.h5
!ml/**/manifest.json
# EXCEPTION: the trained, registered model artifacts ARE committed so the app
# works out-of-the-box and CI/Docker builds are reproducible. Raw training data
# and datasets stay ignored (above); only the final small model files ship.
!ml/artifacts/**/*.joblib

# Local dev database (+ SQLite WAL sidecar files)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal

