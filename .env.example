# CardioSense AI — copy to .env and fill in. NEVER commit .env.

# ---- App ----
APP_ENV=development
APP_NAME=CardioSense AI
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# ---- Security (Blueprint Section 16) ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-me-with-a-64-byte-urlsafe-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# ---- Database ----
# Dev default is local SQLite so the app runs with zero setup.
# Production/staging: swap to Postgres, e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/cardiosense
DATABASE_URL=sqlite+pysqlite:///./cardiosense.db

# ---- Object storage (raw PCG/ECG bytes never go in Postgres) ----
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
# S3/MinIO (when STORAGE_BACKEND=s3)
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Uploads ----
MAX_UPLOAD_MB=25

# ---- Monitoring (optional) ----
SENTRY_DSN=

# ---- Design tool-chain MCP keys (optional, Buildchain Brief Section 2) ----
# These belong in .kiro/settings/mcp.json which is gitignored.
STITCH_API_KEY=
TWENTYFIRST_API_KEY=
